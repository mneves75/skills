#!/usr/bin/env bash
# Real catalog plus isolated planted violations; no network or source changes.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
mkdir -p "$root/.scratch"
python3 - "$root" <<'PY'
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

root = Path(sys.argv[1])
guard = root / "tools/scripts/check-readiness-catalog.py"
skill = Path("skills/mneves-production-readiness")
refs = skill / "references"
spec = Path("docs/specs/production-readiness/spec.md")
ledger = Path("docs/readiness/ledger.md")
failures = 0

def check(name, tree, expected, message):
    global failures
    result = subprocess.run([sys.executable, str(guard), str(tree)], capture_output=True, text=True)
    output = result.stdout + result.stderr
    if result.returncode == expected and message in output:
        print("PASS " + name)
    else:
        failures += 1
        print(f"FAIL {name}: exit {result.returncode}, wanted {expected}; {output.strip()}")

def replace(tree, path, old, new):
    file = tree / path
    text = file.read_text()
    assert old in text, (path, old)
    file.write_text(text.replace(old, new, 1))

def remove_line(tree, path, prefix):
    file = tree / path
    lines = file.read_text().splitlines(True)
    index = next(i for i, line in enumerate(lines) if line.startswith(prefix))
    del lines[index]
    file.write_text("".join(lines))

def unmapped(tree):
    file = tree / spec
    file.write_text(re.sub(r"\bDM-01\b", "DM-02", file.read_text()))

cases = [
    ("stripped heading", lambda t: replace(t, refs / "controls-data.md", "### DM-01", "DM-01"), "heading marker"),
    ("duplicate ID", lambda t: replace(t, refs / "controls-data.md", "### DM-02", "### DM-01"), "duplicate control ID"),
    ("missing tier", lambda t: remove_line(t, refs / "controls-data.md", "`blocker`"), "tier"),
    ("missing Evidence", lambda t: remove_line(t, refs / "controls-data.md", "- Evidence:"), "Evidence"),
    ("missing Verify", lambda t: remove_line(t, refs / "controls-data.md", "- Verify:"), "Verify"),
    ("missing Fallback", lambda t: remove_line(t, refs / "controls-security.md", "- Fallback:"), "Fallback"),
    ("missing B item", lambda t: remove_line(t, spec, "| B1 |"), "B1 must appear exactly once"),
    ("missing R item", lambda t: remove_line(t, spec, "| R1 |"), "R1 must appear exactly once"),
    ("duplicate item", lambda t: replace(t, spec, "| B2 |", "| B1 |"), "B1 must appear exactly once"),
    ("undefined ID", lambda t: replace(t, spec, "| DM-01 |", "| XX-99 |"), "undefined control ID XX-99"),
    ("unmapped control", unmapped, "control DM-01 is missing from Preservation map"),
    ("missing catalog version", lambda t: remove_line(t, refs / "gates.md", "Catalog version:"), "Catalog version"),
    ("unlinked reference", lambda t: replace(t, skill / "SKILL.md", "references/sources.md", "references/not-sources.md"), "unlinked reference sources.md"),
    ("malformed heading", lambda t: replace(t, refs / "controls-data.md", "### DM-01", "### DM-1"), "invalid control heading"),
    ("missing ledger", lambda t: (t / ledger).unlink(), "ledger.md:1: cannot read"),
    ("missing ledger row", lambda t: remove_line(t, ledger, "| DM-03 |"), "DM-03 needs exactly one ledger row (found 0)"),
    ("duplicate ledger row", lambda t: replace(t, ledger, "| DM-03 |", "| DM-04 |"), "DM-04 needs exactly one ledger row (found 2)"),
    ("unknown ledger row", lambda t: replace(t, ledger, "| DM-03 |", "| XX-99 |"), "ledger row for unknown control XX-99"),
    ("invalid ledger status", lambda t: replace(t, ledger, "| DM-03 | NOT APPLICABLE |", "| DM-03 | N/A |"), "DM-03: invalid status N/A"),
    ("totals mismatch", lambda t: replace(t, ledger, "· PASS 1 ·", "· PASS 2 ·"), "Totals says PASS 2, table has 1"),
    ("missing totals", lambda t: remove_line(t, ledger, "Totals:"), "needs exactly one Totals line (found 0)"),
    ("cursor disagreement", lambda t: replace(t, ledger, "Cursors: production abc1234", "Cursors: production 0000aaa"), "production commit disagrees"),
    ("waiver without underlying", lambda t: replace(t, ledger, " · underlying NOT TESTED; owner waiver", " · owner waiver"), "WAIVED row lacks an underlying status"),
    ("waiver without expiry", lambda t: replace(t, ledger, "to 2027-01-01T00:00:00Z", "to tomorrow"), "WAIVED row lacks an expiry"),
    ("gate heading case", lambda t: (replace(t, ledger, "## Gate history", "## Gate History"), replace(t, ledger, "Cursors: production abc1234", "Cursors: production 0000aaa")), "production commit disagrees"),
    ("cursor vs binding without history", lambda t: (replace(t, ledger, "| production | 0000aaa |", "| staging | 0000aaa |"), replace(t, ledger, "| production | abc1234 |", "| staging | abc1234 |"), replace(t, ledger, "Cursors: production abc1234", "Cursors: production 0000aaa")), "production commit disagrees"),
    ("empty gate commit", lambda t: replace(t, ledger, "| production | abc1234 |", "| production |  |"), "production gate-history row has no commit"),
    ("duplicate LOCAL row", lambda t: replace(t, ledger, "| DM-02 |", "| LOCAL-01 | PASS | advisory | x | @o | — |\n| LOCAL-01 | PASS | advisory | x | @o | — |\n| DM-02 |"), "LOCAL-01 needs exactly one ledger row (found 2)"),
    ("duplicate Totals status", lambda t: replace(t, ledger, "· PASS 1 ·", "· PASS 1 · PASS 1 ·"), "Totals states PASS more than once"),
]
valid_cases = [
    ("synthetic ledger", lambda t: None),
    ("padded cells", lambda t: replace(t, ledger, "| DM-03 | NOT APPLICABLE |", "|  DM-03  |  NOT APPLICABLE  |")),
    # A skipped last row would compare the cursor against the older production row instead.
    ("gate row trailing space", lambda t: replace(t, ledger, "| DM-01 |\n", "| DM-01 | \n")),
]

def synthetic_ledger():
    """A valid ledger built from the catalog, so ledger cases never depend on release data."""
    ids = sorted({m for f in (root / refs).glob("controls-*.md") for m in re.findall(r"^### ([A-Z]{2,3}-[0-9]{2}) ", f.read_text(), re.M)})
    status = {"DM-01": "WAIVED", "DM-02": "PASS"}
    evidence = {"DM-01": "source · underlying NOT TESTED; owner waiver @owner to 2027-01-01T00:00:00Z"}
    rows = [f"| {i} | {status.get(i, 'NOT APPLICABLE')} | blocker | {evidence.get(i, 'source')} | @owner | — |" for i in ids]
    return "\n".join([
        "# Production readiness ledger", "",
        "Cursors: production abc1234 (2026-01-01)",
        "Binding run for production: 2026-01-01 at abc1234000000000000000000000000000000000 · verdict ready",
        f"Totals: {len(ids)} rows · NOT APPLICABLE {len(ids) - 2} · PASS 1 · FAIL 0 · NOT TESTED 0 · BLOCKED 0 · WAIVED 1.", "",
        "| ID | Status | Tier | Evidence | Owner | Next action or waiver |", "|---|---|---|---|---|---|", *rows, "",
        "## Gate history", "",
        "| Date | Target | Commit | Verdict | Open blockers | Waivers |", "|---|---|---|---|---|---|",
        "| 2025-12-01 | production | 0000aaa | ready | 0 | — |",
        "| 2026-01-01 | production | abc1234 | ready | 0 | DM-01 |", "",
    ])

check("real tree", root, 0, "readiness catalog: OK")
with tempfile.TemporaryDirectory(prefix="catalog-tests.", dir=root / ".scratch") as temporary:
    all_cases = [(n, m, 1, msg) for n, m, msg in cases] + [(n, m, 0, "readiness catalog: OK") for n, m in valid_cases]
    for index, (name, mutate, expected, message) in enumerate(all_cases):
        tree = Path(temporary) / str(index)
        shutil.copytree(root / skill, tree / skill)
        (tree / spec).parent.mkdir(parents=True)
        shutil.copy2(root / spec, tree / spec)
        (tree / ledger).parent.mkdir(parents=True)
        (tree / ledger).write_text(synthetic_ledger())
        mutate(tree)
        check(name, tree, expected, message)
    # A long row must not stall the guard (RC-A-02: overlapping \s* and [^|]* backtracked).
    tree = Path(temporary) / "slow-row"
    shutil.copytree(root / skill, tree / skill)
    (tree / spec).parent.mkdir(parents=True)
    shutil.copy2(root / spec, tree / spec)
    (tree / ledger).parent.mkdir(parents=True)
    (tree / ledger).write_text(synthetic_ledger() + "| DM-99 |" + " " * 20000 + "\n")
    try:
        subprocess.run([sys.executable, str(guard), str(tree)], capture_output=True, timeout=3)
        print("PASS long row within 3 s")
    except subprocess.TimeoutExpired:
        failures += 1
        print("FAIL long row: guard exceeded 3 s")
if failures:
    print(f"readiness catalog tests FAILED ({failures})")
    sys.exit(1)
print(f"readiness catalog tests passed ({len(cases)} planted violations, {len(valid_cases)} valid variants)")
PY
