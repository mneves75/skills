#!/usr/bin/env bash
# Exercise the real generator in an isolated copy: reject truncated output and
# non-repeatable builds without changing the working tree.
set -euo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
cd "$root"
python3 - <<'PY'
import hashlib
from collections import Counter
from html.parser import HTMLParser
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

source = Path.cwd()
skill_names = {path.parent.name for path in (source / 'skills').glob('*/SKILL.md')}
collection_count = len(list((source / 'collections/pstack/skills').glob('*/SKILL.md')))

class Catalog(HTMLParser):
    def __init__(self):
        super().__init__()
        self.entries = []
        self.ids = set()
        self.entry = None
        self.in_name = False
        self.collection_depth = 0
        self.collection_text = ''

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if tag == 'div':
            if self.collection_depth:
                self.collection_depth += 1
            elif 'collection' in attrs.get('class', '').split():
                self.collection_depth = 1
        if attrs.get('id'):
            self.ids.add(attrs['id'])
        if tag == 'article' and 'skill' in attrs.get('class', '').split():
            self.entry = {'name': '', 'guides': []}
            self.entries.append(self.entry)
        if self.entry is not None:
            if tag == 'h3':
                self.in_name = True
            if tag == 'a':
                self.entry['guides'].append(attrs.get('href'))

    def handle_endtag(self, tag):
        if tag == 'div' and self.collection_depth:
            self.collection_depth -= 1
        if tag == 'h3':
            self.in_name = False
        if tag == 'article':
            self.entry = None

    def handle_data(self, data):
        if self.collection_depth:
            self.collection_text += data
        if self.in_name and self.entry is not None:
            self.entry['name'] += data

def validate_catalog(index, howto, names):
    catalog, guide = Catalog(), Catalog()
    catalog.feed(index)
    guide.feed(howto)
    quantities = re.findall(r'\bcollection of ([0-9]+) engineering workflow skills\b', catalog.collection_text)
    assert quantities == [str(collection_count)], f'collection count differs from source: {quantities}, expected {collection_count}'
    actual = Counter(entry['name'].strip() for entry in catalog.entries)
    assert actual == Counter({name: 1 for name in names}), f'catalog differs from source skills: {actual}'
    for entry in catalog.entries:
        name = entry['name'].strip()
        assert entry['guides'] == [f'howto.html#{name}'], f'{name}: incorrect guide link'
        assert name in guide.ids, f'{name}: guide anchor missing from HOWTO'

class GuideAccessibility(HTMLParser):
    def __init__(self):
        super().__init__()
        self.main_count = 0
        self.in_main = False
        self.scroll_regions = []

    def handle_starttag(self, tag, attrs):
        if tag == 'main':
            self.main_count += 1
            self.in_main = True
        if tag in ('pre', 'table'):
            self.scroll_regions.append((tag, dict(attrs).get('tabindex'), self.in_main))

    def handle_endtag(self, tag):
        if tag == 'main':
            self.in_main = False

def validate_guide_accessibility(html):
    guide = GuideAccessibility()
    guide.feed(html)
    assert guide.main_count == 1, 'guide must expose exactly one main landmark'
    assert guide.scroll_regions, 'guide fixture has no code/table scroll containers'
    assert all(tabindex == '0' and in_main for _, tabindex, in_main in guide.scroll_regions), \
        'guide code/table scroll containers must be keyboard-focusable within main'

with tempfile.TemporaryDirectory(prefix='skills-build-site-') as scratch:
    target = Path(scratch)
    for name in ('HOWTO.md', 'CHANGELOG.md', 'site/index.html',
                 'tools/scripts/build-site.sh', 'tools/scripts/check-html-active.py',
                 'tools/scripts/changelog-rows.py'):
        destination = target / name
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(source / name, destination)
    # The build runs the integrity-locked marked from tools/ (`bun install` there first).
    (target / 'tools/node_modules').symlink_to(source / 'tools/node_modules', target_is_directory=True)
    previous = None
    for attempt in range(2):
        result = subprocess.run(['bash', 'tools/scripts/build-site.sh'], cwd=target,
                                text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        print(result.stdout, end='')
        assert result.returncode == 0, f'build failed: {result.returncode}'
        html = (target / 'site/howto.html').read_text()
        assert '<h2 id="combining-them">Combining them</h2>' in html, 'HOWTO truncated before its final section'
        validate_guide_accessibility(html)
        index = (target / 'site/index.html').read_text()
        validate_catalog(index, html, skill_names)
        current = {name: hashlib.sha256((target / name).read_bytes()).hexdigest()
                   for name in ('site/howto.html', 'site/index.html')}
        if previous is not None:
            assert current == previous, 'generated site changed on an unchanged second build'
        previous = current
    print(f'PASS: complete HOWTO and repeatable generated site: {previous}')
    first_entry = re.search(r'<article class="skill(?: new)?">.*?</article>', index, re.S)
    assert first_entry, 'missing catalog fixture entry'
    entry = first_entry.group()
    first_guide = re.search(r'href="howto.html#[^"]+"', entry)
    assert first_guide, 'missing catalog fixture guide'
    mutants = {
        'missing entry': index.replace(entry, '', 1),
        'duplicate entry': index.replace(entry, entry + entry, 1),
        'broken guide': index.replace(first_guide.group(),
                                    'href="howto.html#missing-guide"', 1),
        'stale collection count': index.replace(f'collection of {collection_count}',
                                                f'collection of {collection_count - 1}', 1),
        'hidden collection count': index.replace(f'collection of {collection_count}',
            f'collection of thirty-three <span hidden>{collection_count}</span>', 1),
    }
    for label, mutant in mutants.items():
        assert mutant != index, f'{label} mutation did not plant a violation'
        try:
            validate_catalog(mutant, html, skill_names)
        except AssertionError:
            print(f'PASS: reject {label}')
        else:
            raise AssertionError(f'catalog guard accepted {label}')
    guide_mutants = {
        'missing main landmark': html.replace('<main>', '<div>', 1).replace('</main>', '</div>', 1),
        'non-focusable scroll container': html.replace('tabindex="0"', 'tabindex="-1"', 1),
    }
    for label, mutant in guide_mutants.items():
        assert mutant != html, f'{label} mutation did not plant a violation'
        try:
            validate_guide_accessibility(mutant)
        except AssertionError:
            print(f'PASS: reject {label}')
        else:
            raise AssertionError(f'guide accessibility guard accepted {label}')

    # The active-content guard, through the real generator: each payload appended to a copy of
    # HOWTO.md must stop the build before site/howto.html is written. Several of them are read as
    # inert by Python's parser but expose an event handler to a browser's HTML5 parser.
    active_payloads = {
        'noscript parser confusion': '<noscript><p title="</noscript><img src=x onerror=alert(1)>"></noscript>',
        'xmp parser confusion': '<xmp><p title="</xmp><img src=x onerror=alert(1)>"></xmp>',
        'CDATA read as a bogus comment': '<![CDATA[><img src=x onerror=alert(1)>]]>',
        'abruptly closed comment': '<!--><img src=x onerror=alert(1)>-->',
        'comment closed by --!>': '<!-- --!><img src=x onerror=alert(1)> -->',
        'processing instruction': '<?php echo 1; ?>',
        'declaration': '<!DOCTYPE html>',
        'markup left as text': '<div>\n1 < 2\n</div>',
        'javascript: in a non-URL attribute': '<p data-x="javascript:alert(1)">x</p>',
        'entity-encoded javascript: URL': '<a href="&#106;avascript:alert(1)">x</a>',
        'data: URL': '<a href="data:text/html,x">x</a>',
        'event handler': '<p onclick="alert(1)">x</p>',
        'attribute outside the accepted set': '<p style="color:red">x</p>',
        'unknown element with attributes': '<task hidden>x</task>',
    }
    for element in ('script', 'style', 'textarea', 'title', 'xmp', 'plaintext', 'iframe', 'noembed',
                    'noframes', 'noscript', 'template', 'svg', 'math', 'object', 'embed'):
        active_payloads[f'<{element}> element'] = f'<{element}>x</{element}>'
    howto = (source / 'HOWTO.md').read_text()
    output = target / 'site/howto.html'

    def build_with(extra):
        (target / 'HOWTO.md').write_text(f'{howto}\n\n{extra}\n')
        output.unlink(missing_ok=True)
        return subprocess.run(['bash', 'tools/scripts/build-site.sh'], cwd=target, text=True,
                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT)

    accepted = []
    for label, payload in active_payloads.items():
        result = build_with(payload)
        if result.returncode == 0 or output.exists() or 'check-html-active:' not in result.stdout:
            accepted.append(label)
        else:
            print(f'PASS: reject {label}')
    assert not accepted, f'the build accepted active HTML: {accepted}'
    safe = ('Prose that mentions javascript: and data: URLs, the `<noscript>` element and an '
            '`onclick=` handler.\n\n```html\n' + '\n'.join(active_payloads.values()) + '\n```')
    result = build_with(safe)
    assert result.returncode == 0 and output.exists(), f'the build rejected prose and code:\n{result.stdout}'
    print('PASS: prose and code that only mention active HTML still build')

    # changelog-rows.py on hostile entries: markup in the date is escaped, and a long run of
    # brackets in a bullet (the link pattern used to backtrack quadratically) stays fast.
    rows_script = target / 'tools/scripts/changelog-rows.py'
    page = target / 'site/rows-index.html'
    for label, entry, expect in (
        ('date markup is escaped', '## [9.9.9] - <img/src=x>\n\n- **Thing**: one.\n', '&lt;img/src=x&gt;'),
        ('long bracket run stays fast', '## [9.9.9] - 2026-01-01\n\n- ' + '[' * 20000 + '\n', '9.9.9'),
        ('long link run stays fast', '## [9.9.9] - 2026-01-01\n\n- ' + '[a](' * 40000 + '\n', '9.9.9'),
    ):
        (target / 'rows-CHANGELOG.md').write_text(entry)
        page.write_text('<ul>\n<!-- changelog:start -->\n<!-- changelog:end -->\n</ul>\n')
        try:
            run = subprocess.run([sys.executable, str(rows_script), str(target / 'rows-CHANGELOG.md'), str(page)],
                                 text=True, capture_output=True, timeout=3)
        except subprocess.TimeoutExpired:
            raise AssertionError(f'changelog-rows: {label}: exceeded 3 s')
        assert run.returncode == 0, f'changelog-rows: {label}: {run.stderr}'
        built = page.read_text()
        assert expect in built and '<img' not in built, f'changelog-rows: {label}: {built[:200]}'
        print(f'PASS: changelog-rows {label}')
PY
