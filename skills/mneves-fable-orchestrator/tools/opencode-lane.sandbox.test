#!/usr/bin/env bash
# Real Seatbelt controls, no model. Run outside an existing sandbox.
set -euo pipefail
umask 077
require_sandbox() {
  if [ ! -x "$1" ]; then
    if [ "${OPENCODE_LANE_REQUIRE_SANDBOX:-0}" = '1' ]; then
      echo 'FAIL: sandbox-exec required'
      exit 1
    fi
    echo 'SKIP: no sandbox-exec'
    exit 0
  fi
}
require_sandbox /usr/bin/sandbox-exec
LANE="$(cd "$(dirname "$0")" && pwd -P)/opencode-lane"
TMP="$(mktemp -d)"
cleanup() {
  python3 - "$TMP" <<'PY'
import shutil, sys
shutil.rmtree(sys.argv[1])
PY
}
trap cleanup EXIT
python3 - "$LANE" "$TMP" <<'PY'
# Python 3.10+, standard library only. _profile never launches opencode.
import contextlib, json, os, pathlib, pwd, select, shutil, signal, socket, subprocess, sys

@contextlib.contextmanager
def home_canary(home, required):
    # Existing files are inspected by name/metadata, then read only with wc -c.
    existing = next((path for path in [home / '.zshrc', home / '.bashrc', home / '.profile',
                                      *home.iterdir()]
                     if path.is_file() and not path.is_symlink()), None)
    if existing is not None:
        yield existing
        return
    if not required:
        raise SystemExit('FAIL: no existing regular file under real HOME to test')
    temporary = pathlib.Path(subprocess.check_output(
        ['mktemp', '-d', str(home / '.opencode-lane-test.XXXXXX')], text=True).strip())
    try:
        canary = temporary / 'canary'
        canary.write_text('sandbox HOME canary\n')
        yield canary
    finally:
        shutil.rmtree(temporary)

tool, root = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]).resolve()
workspace = root / 'workspace'
lanes = root / 'lanes'
box = lanes / 'probe.box'
outside = root / 'sibling'
install = root / 'install'
for directory in (workspace, lanes, box, outside, install):
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
subprocess.run(['git', 'init', '-q', str(workspace)], check=True)
subprocess.run(['git', '-C', str(workspace), 'config', 'core.hooksPath', '.githooks'], check=True)
hooks = workspace / '.githooks'
hooks.mkdir()
hook = hooks / 'pre-commit'
hook.write_text('fixture hook, must remain unchanged\n')
hook_before = hook.read_bytes()
canary = outside / 'canary'
canary.write_text('sandbox sibling canary\n')
home = pathlib.Path(pwd.getpwuid(os.getuid()).pw_dir).resolve()
git = subprocess.check_output(['xcrun', '--find', 'git'], text=True).strip() if \
    shutil.which('xcrun') else shutil.which('git')
state = dict(workspace=str(workspace), git_common=str(workspace / '.git'),
             opencode_root=str(install), git_dir=str(pathlib.Path(git).resolve().parent),
             allow_read=[])
(lanes / 'probe.json').write_text(json.dumps(state))
subprocess.run(['bash', str(tool), '_profile', 'probe'], check=True,
               env=dict(os.environ, OPENCODE_LANE_DIR=str(lanes)))
profile = lanes / 'probe.sb'

def probe(label, command, permitted, profile_path=None):
    result = subprocess.run(['/usr/bin/sandbox-exec', '-f', str(profile_path or profile), *command],
                            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=10)
    if (result.returncode == 0) != permitted:
        sys.exit(f'FAIL: {label}: exit {result.returncode}; {result.stderr.decode(errors="replace")}')
    print('PASS: ' + label)

probe('workspace write allowed', ['/usr/bin/touch', str(workspace / 'allowed')], True)
if not (workspace / 'allowed').is_file():
    sys.exit('FAIL: workspace write returned success without creating file')
try:
    probe('configured workspace hook write denied',
          ['/bin/sh', '-c', 'printf overwritten > "$1"', 'probe', str(hook)], False)
finally:
    if hook.read_bytes() != hook_before:
        sys.exit('FAIL: configured hook bytes changed')
probe('Git directory hook write denied', ['/usr/bin/touch', str(workspace / '.git/hooks/x')], False)
if (workspace / '.git/hooks/x').exists():
    sys.exit('FAIL: denied Git hook exists')
subprocess.run(['git', '-C', str(workspace), '-c', 'user.name=Lane Test',
                '-c', 'user.email=lane@example.invalid', '-c', 'core.hooksPath=/dev/null',
                '-c', 'commit.gpgSign=false', 'commit', '--allow-empty', '-qm', 'fixture'], check=True)
linked = root / 'linked'
subprocess.run(['git', '-C', str(workspace), '-c', 'core.hooksPath=/dev/null',
                'worktree', 'add', '--detach', '-q', str(linked)], check=True)
(lanes / 'linked.box').mkdir(mode=0o700)
(lanes / 'linked.json').write_text(json.dumps(dict(state, workspace=str(linked))))
subprocess.run(['bash', str(tool), '_profile', 'linked'], check=True,
               env=dict(os.environ, OPENCODE_LANE_DIR=str(lanes)))
linked_profile = lanes / 'linked.sb'
pointer = linked / '.git'
pointer_before = pointer.read_bytes()
try:
    probe('Git pointer append-open denied', ['/bin/sh', '-c', ': >> "$1"', 'probe', str(pointer)],
          False, profile_path=linked_profile)
finally:
    if pointer.read_bytes() != pointer_before:
        sys.exit('FAIL: Git pointer bytes changed')
probe('linked workspace write allowed', ['/usr/bin/touch', str(linked / 'allowed')],
      True, profile_path=linked_profile)
if not (linked / 'allowed').is_file():
    sys.exit('FAIL: linked workspace write returned success without creating file')
probe('outside write denied', ['/usr/bin/touch', str(outside / 'denied')], False)
if (outside / 'denied').exists():
    sys.exit('FAIL: denied outside file exists')
# Positive controls establish readable inputs, without exposing their contents.
with home_canary(home, os.environ.get('OPENCODE_LANE_REQUIRE_SANDBOX') == '1') as home_file:
    subprocess.run(['/usr/bin/wc', '-c', str(home_file)], check=True, stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL)
    probe('real HOME read denied', ['/usr/bin/wc', '-c', str(home_file)], False)
for path in (canary,):
    subprocess.run(['/usr/bin/wc', '-c', str(path)], check=True, stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL)
probe('sibling canary read denied', ['/usr/bin/wc', '-c', str(canary)], False)
probe('workspace parent listing allowed', ['/bin/ls', str(workspace.parent)], True)
security = ['/usr/bin/security', 'list-keychains']
if pathlib.Path(security[0]).exists() and subprocess.run(
        security, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10).returncode == 0:
    result = subprocess.run(['/usr/bin/sandbox-exec', '-f', str(profile), *security],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
    if result.returncode == 0:
        sys.exit('FAIL: keychain search list readable inside sandbox')
    print('PASS: keychain search list denied')
else:
    print('SKIP: no keychain')
clipboard = subprocess.run(['/usr/bin/sandbox-exec', '-f', str(profile), '/usr/bin/pbpaste'],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=10)
if clipboard.returncode == 0 and len(clipboard.stdout) != 0:
    sys.exit(f'FAIL: clipboard readable inside sandbox ({len(clipboard.stdout)} bytes)')
print('PASS: clipboard denied or empty')
socket_path = outside / 'ipc.sock'
with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as listener:
    listener.bind(str(socket_path))
    listener.listen(2)
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.connect(str(socket_path))
    accepted, _ = listener.accept()
    accepted.close()
    # The client script is readable in the workspace; only the connect is tested.
    client_script = workspace / 'socket-client.py'
    client_script.write_text('import socket, sys\n'
                             'with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:\n'
                             '    client.connect(sys.argv[1])\n')
    probe('sandbox socket client runtime allowed', [sys.executable, '-c', 'import socket'], True)
    probe('outside Unix socket connect denied', [sys.executable, str(client_script), str(socket_path)], False)
subprocess.run(['/bin/kill', '-0', str(os.getpid())], check=True,
               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
probe('signal to test process denied', ['/bin/kill', '-0', str(os.getpid())], False)
signal_control = ('import signal, subprocess\n'
                  'child = subprocess.Popen(["/bin/sleep", "30"])\n'
                  'child.terminate()\n'
                  'if child.wait(timeout=5) != -signal.SIGTERM:\n'
                  '    raise SystemExit("child did not receive SIGTERM")\n'
                  'print("child SIGTERM delivered")\n')
with subprocess.Popen(['/usr/bin/sandbox-exec', '-f', str(profile),
                       sys.executable, '-c', signal_control],
                      stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, start_new_session=True) as control:
    try:
        output, _ = control.communicate(timeout=10)
        if control.returncode != 0 or output.strip() != b'child SIGTERM delivered':
            sys.exit(f'FAIL: same-sandbox child SIGTERM: exit {control.returncode}')
    finally:
        # This group belongs only to the control, including a child left by a failed signal.
        try:
            os.killpg(control.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
print('PASS: same-sandbox child SIGTERM allowed')
preferences = subprocess.run(['/usr/bin/sandbox-exec', '-f', str(profile),
                              '/usr/bin/defaults', 'read', 'com.apple.finder'],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=10)
if len(preferences.stdout) != 0:
    sys.exit(f'FAIL: Finder preferences readable inside sandbox ({len(preferences.stdout)} bytes)')
print('PASS: Finder preferences returned no data')
probe('/dev/null write allowed', ['/bin/sh', '-c', 'printf probe > /dev/null'], True)
master, slave = os.openpty()
try:
    slave_path = os.ttyname(slave)
    os.write(slave, b'control')
    if not select.select([master], [], [], 2)[0] or os.read(master, 1024) != b'control':
        sys.exit('FAIL: outside pty positive control')
    writer = ('import os, sys\n'
              'fd = os.open(sys.argv[1], os.O_WRONLY | os.O_NOCTTY)\n'
              'try:\n'
              '    os.write(fd, b"blocked pty probe")\n'
              'finally:\n'
              '    os.close(fd)\n')
    result = subprocess.run(['/usr/bin/sandbox-exec', '-f', str(profile),
                             sys.executable, '-c', writer, slave_path],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
    received = len(os.read(master, 1024)) if select.select([master], [], [], .2)[0] else 0
    if result.returncode == 0 or received != 0:
        sys.exit(f'FAIL: outside pty write: exit {result.returncode}, {received} bytes received')
    print('PASS: outside pty write denied, 0 bytes received')
finally:
    os.close(master)
    os.close(slave)
own_pty = ('import os, select\n'
           'master, slave = os.openpty()\n'
           'try:\n'
           '    os.write(slave, b"own pty")\n'
           '    if not select.select([master], [], [], 2)[0] or os.read(master, 1024) != b"own pty":\n'
           '        raise SystemExit("own pty round trip failed")\n'
           'finally:\n'
           '    os.close(master)\n'
           '    os.close(slave)\n')
probe('own pty write and read allowed', [sys.executable, '-c', own_pty], True)
print('PASS: real sandbox controls (no model invoked)')
PY
