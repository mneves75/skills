        (root / 'private-kind').write_text(kind)
        (root / 'private-hostile.py').write_text(r'''import os, pathlib, shlex, subprocess
root = pathlib.Path(__file__).resolve().parent
kind = (root / 'private-kind').read_text()
ws = pathlib.Path.cwd()
marker = root / ('private-marker-' + kind)
program = '#!/bin/sh\n: > ' + shlex.quote(str(marker)) + '\ncat\n'
(ws / 'tracked.txt').write_text('worker edit\n')
(ws / 'edited.txt').write_text('added edit\n')
(ws / 'locally-excluded.txt').write_text('must not transfer\n')
if kind == 'repository':
    for name in ('clean.sh', 'fsmon.sh', '.githooks/post-index-change'):
        (ws / name).write_text(program)
    (ws / '.gitattributes').write_text('* filter=x\n')
elif kind == 'home':
    home = pathlib.Path(os.environ['HOME'])
    (home / '.gitconfig').write_text('[core]\n fsmonitor = ./fsmon.sh\n')
    config = home / '.config/git'
    config.mkdir(parents=True)
    (config / 'ignore').write_text('edited.txt\n')
    (config / 'attributes').write_text('* -diff\n')
    (ws / 'fsmon.sh').write_text(program)
else:
    nested = ws / 'nested'
    subprocess.run(['git', 'init', '-q', str(nested)], check=True)
    (nested / 'file').write_text('base\n')
    subprocess.run(['git', '-C', str(nested), 'add', '.'], check=True)
    subprocess.run(['git', '-C', str(nested), '-c', 'user.name=Lane Test',
                    '-c', 'user.email=lane@example.invalid', '-c', 'commit.gpgSign=false',
                    'commit', '-qm', 'nested base'], check=True)
    for name in ('fsmon.sh', 'clean.sh'):
        (nested / name).write_text(program)
        (nested / name).chmod(0o700)
    for key, value in [('core.fsmonitor', './fsmon.sh'), ('filter.x.clean', './clean.sh')]:
        subprocess.run(['git', '-C', str(nested), 'config', key, value], check=True)
    (nested / '.gitattributes').write_text('* filter=x\n')
    (nested / 'file').write_text('dirty\n')
''')
        (root / 'mode').write_text('private-harvest')
        start('private-' + kind, cwd=work)
        state_path = lanes / f'private-{kind}.json'
        private_state = json.loads(state_path.read_text())
        patch_path = pathlib.Path(private_state['patch'])
        patch_data = patch_path.read_bytes()
        check(not (root / f'private-marker-{kind}').exists(), 'harvest executed worker program')
        check(b'+worker edit' in patch_data and b'edited.txt' in patch_data,
