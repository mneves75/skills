    gate.write_text('''#!/usr/bin/env python3
import json, os, pathlib, subprocess, sys, time
root = pathlib.Path(__file__).resolve().parent.parent
scale = float((root / 'time-scale').read_text())
record = dict(argv=sys.argv[1:], stdin=sys.stdin.read(), cwd=os.getcwd(), env=dict(os.environ))
with (root / 'gate-calls').open('a') as out:
    out.write(json.dumps(record) + '\\n')
if sys.argv[1:] == ['hang']:
    child = subprocess.Popen([sys.executable, '-c', f'import time; time.sleep({40 * scale})'])
    (root / 'exec-child.pid').write_text(str(child.pid))
    time.sleep(40 * scale)
if sys.argv[1:] == ['quiet']:
    time.sleep(.2 * scale)
    sys.exit(0)
print(json.dumps(record))
print('gate stderr', file=sys.stderr)
sys.exit(23)
''')
    gate.chmod(0o700)
