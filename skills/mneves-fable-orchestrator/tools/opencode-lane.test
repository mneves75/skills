    check(not (root / 'executed-marker').exists(), 'clean worktree executed planted code')
    control = root / 'hook-control'
    init_repo(control)
    control_hook = control / '.git/hooks/pre-commit'
    shutil.copyfile(hostile / '.githooks/pre-commit', control_hook)
    control_hook.chmod(0o700)
    subprocess.run(['git', '-C', str(control), '-c', 'user.name=Lane Test',
                    '-c', 'user.email=lane@example.invalid', '-c', 'commit.gpgSign=false',
                    '-c', 'core.hooksPath=' + str(control_hook.parent),
                    'commit', '--allow-empty', '-qm', 'positive control'], check=True)
    check((root / 'executed-marker').is_file(), 'planted hook positive control did not fire')
    run('drop', 'harvest-hostile')
    check(not list(lanes.glob('harvest-hostile.*')), 'drop left harvested patches')
    (root / 'mode').write_text('ok')
    (root / 'sandbox-mode').write_text('enforce')
    for kind in ('repository', 'home', 'nested', 'nested-modules'):
        scenario = {'repository': 'harvest ignores repository programs',
                    'home': 'harvest ignores worker HOME',
                    'nested': 'harvest does not recurse into nested repositories',
                    'nested-modules': 'harvest overrides committed submodule ignore none'}[kind]
        source = root / f'private-source-{kind}'
        work = root / f'private-work-{kind}'
