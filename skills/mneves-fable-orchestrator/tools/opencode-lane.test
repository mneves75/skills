#!/usr/bin/env bash
# Fake-only end-to-end checks. Never resolves or invokes the host's opencode.
# OPENCODE_LANE_TEST_TIMEOUT scales the 12-second command budget and timing probes.
set -euo pipefail
umask 077
LANE="$(cd "$(dirname "$0")" && pwd -P)/opencode-lane"
TMP="$(mktemp -d)"
cleanup() {
  python3 - "$TMP" <<'PY'
import os, pathlib, shutil, signal, sys
root = pathlib.Path(sys.argv[1])
for file in root.glob('*.pid'):
    try:
        os.kill(int(file.read_text()), signal.SIGKILL)
    except (ProcessLookupError, ValueError):
        pass
shutil.rmtree(root)
PY
}
trap cleanup EXIT
mkdir -p "$TMP/bin"
cat > "$TMP/bin/opencode" <<'PY'
#!/usr/bin/env python3
import json, os, pathlib, subprocess, sys, time
root = pathlib.Path(__file__).resolve().parent.parent
scale = float((root / 'time-scale').read_text())
mode = (root / 'mode').read_text().strip()
args = sys.argv[1:]
with (root / 'calls').open('a') as out:
    out.write(json.dumps(dict(argv=args, stdin=sys.stdin.read(), env=dict(os.environ),
                              cwd=os.getcwd())) + '\n')
if args == ['models', '--standalone']:
    if (root / 'models-mode').read_text() == 'delayed':
        time.sleep(1.3 * scale)
    print((root / 'models-list').read_text(), end='', flush=True)
    if (root / 'models-mode').read_text() == 'slow':
        time.sleep(40 * scale)
    sys.exit(int((root / 'models-exit').read_text()))
elif args[:2] == ['session', 'export']:
    if mode == 'export-write-config':
        pathlib.Path('opencode.json').write_text('{}')
    model = 'other-model' if mode in ('wrong-model', 'provider-wrong-model') else 'fake-model'
    print(json.dumps({'info': {'model': {'providerID': 'fakeprov', 'id': model}}}))
elif args[:1] == ['run']:
    if mode == 'hostile':
        subprocess.run([sys.executable, str(root / 'hostile.py')], check=True)
    if mode == 'private-harvest':
        subprocess.run([sys.executable, str(root / 'private-hostile.py')], check=True)
    if mode in ('provider-error', 'provider-config', 'provider-wrong-model'):
        if mode == 'provider-config':
            pathlib.Path('opencode.json').write_text('{}')
        if mode == 'provider-wrong-model':
            print(json.dumps({'type': 'step_start', 'sessionID': 's-123'}))
        message = (root / 'provider-message').read_text()
        print(json.dumps({'type': 'error', 'error': {'type': 'provider.no-route', 'message': message}}))
        sys.exit(int((root / 'provider-exit').read_text()))
    if mode == 'hang':
        child = subprocess.Popen([sys.executable, '-c', f'import time; time.sleep({40 * scale})'])
        (root / 'grandchild.pid').write_text(str(child.pid))
        time.sleep(40 * scale)
    if mode == 'partial':
        print('{', end='', flush=True)
        time.sleep(40 * scale)
    session = (root / 'session').read_text().strip()
    print(json.dumps({'type': 'step_start', 'sessionID': session}), flush=True)
    if mode == 'slow':
        time.sleep(40 * scale)
    if mode == 'write-config':
        pathlib.Path('opencode.json').write_text('{}')
    if mode == 'write-claude':
        pathlib.Path('.claude').mkdir()
    if mode == 'background':
        child = subprocess.Popen([sys.executable, '-c', f'import time; time.sleep({40 * scale})'])
        (root / 'background.pid').write_text(str(child.pid))
    if mode != 'no-text':
        for text in ['hello ', (root / 'text').read_text()]:
            print(json.dumps({'type': 'text', 'part': {'text': text}}), flush=True)
    if mode == 'fail':
        print('fake backend failed', file=sys.stderr)
        sys.exit(17)
else:
    sys.exit('unexpected fake opencode arguments')
PY
cat > "$TMP/bin/sandbox" <<'PY'
#!/usr/bin/env python3
import json, os, pathlib, sys
root = pathlib.Path(__file__).resolve().parent.parent
args = sys.argv[1:]
assert args[0] == '-f' and pathlib.Path(args[1]).is_file()
with (root / 'sandbox-calls').open('a') as out:
    out.write(json.dumps(args) + '\n')
with (root / 'sandbox-environments').open('a') as out:
    out.write(json.dumps(dict(os.environ)) + '\n')
cmd = args[2:]
mode = (root / 'sandbox-mode').read_text().strip()
if cmd in ([str(root / 'bin/security'), 'list-keychains'], ['/usr/bin/security', 'list-keychains']):
    print('FAKE PRIVATE KEYCHAIN OUTPUT')
    sys.exit(0 if mode == 'keychain-leak' else 1)
if cmd[0] == '/bin/sh':
    if mode != 'git-leak' and (cmd[-1].endswith('/.git') or '/.git/' in cmd[-1]):
        sys.exit(1)
    if mode == 'deny-workspace' and cmd[-1].endswith('.opencode-lane-selftest'):
        sys.exit(1)
    if mode != 'leak' and cmd[-1].endswith('.sbx-probe'):
        sys.exit(1)
    if mode not in ('leak', 'canary-leak') and cmd[-1].endswith('.canary'):
        sys.exit(1)
    if mode != 'home-leak' and cmd[-1].endswith('.home-canary'):
        sys.exit(1)
os.execvp(cmd[0], cmd)
PY
chmod +x "$TMP/bin/opencode" "$TMP/bin/sandbox"
python3 - "$LANE" "$TMP" <<'PY'
# Python 3.10+, standard library only.
import ast, contextlib, json, math, os, pathlib, re, shutil, signal, stat, subprocess, sys, time

os.environ['GIT_CONFIG_NOSYSTEM'] = '1'
os.environ['GIT_CONFIG_GLOBAL'] = '/dev/null'
tool, root = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]).resolve()
command_timeout = float(os.environ.get('OPENCODE_LANE_TEST_TIMEOUT', '12'))
if not math.isfinite(command_timeout) or command_timeout <= 0:
    sys.exit('OPENCODE_LANE_TEST_TIMEOUT must be positive and finite')
scale = command_timeout / 12
(root / 'time-scale').write_text(str(scale))
bin_dir = root / 'bin'
# Trace the actual supervisor at main() entry; all other Python invocations use
# the original interpreter. This never inspects a real process's environment.
shim = bin_dir / 'python3'
shim.write_text('#!' + sys.executable + '\n' + r'''
import json, os, pathlib, platform, pwd, shutil, subprocess, sys, types
root = pathlib.Path(__file__).resolve().parent.parent
if sys.argv[1:2] != ['-']:
    os.execv(sys.executable, [sys.executable, *sys.argv[1:]])
if (root / 'platform').exists():
    platform.system = lambda: (root / 'platform').read_text()
    # Simulate an executable foreign sandbox, but never launch the host binaries.
    isfile, access = os.path.isfile, os.access
    os.path.isfile = lambda path: True if path in ('/usr/bin/sandbox-exec', '/usr/bin/security') else isfile(path)
    os.access = lambda path, mode: True if path in ('/usr/bin/sandbox-exec', '/usr/bin/security') else access(path, mode)
pwd.getpwuid = lambda uid: types.SimpleNamespace(pw_dir=str(root / 'account-home'))
popen = subprocess.Popen
def guarded_popen(command, *args, **kwargs):
    if '/usr/bin/sandbox-exec' in command or command[0] == '/usr/bin/security':
        raise AssertionError('test refused to execute host sandbox or security')
    return popen(command, *args, **kwargs)
subprocess.Popen = guarded_popen
which = shutil.which
shutil.which = lambda name, *a, **kw: None if name == 'git' and (root / 'no-git').exists() else which(name, *a, **kw)
def trace(frame, event, arg):
    if event == 'call' and frame.f_code.co_name == 'main':
        with (root / 'supervisor-keys').open('a') as out:
            out.write(json.dumps(list(frame.f_globals['os'].environ)) + '\n')
        sys.setprofile(None)
def audit(event, args):
    if event == 'os.link' and str(args[1]).endswith('.json'):
        value = json.loads(pathlib.Path(args[0]).read_text())
        with (root / 'reservations').open('a') as out:
            out.write(json.dumps({'target': str(args[1]), 'state': value}) + '\n')
        if (root / 'plant-collision').exists():
            pathlib.Path(args[1]).write_text('{"workspace":"held"}')
sys.addaudithook(audit)
sys.setprofile(trace)
sys.argv = sys.argv[1:]
exec(compile(sys.stdin.read(), '<lane-supervisor>', 'exec'), {'__name__': '__main__'})
''')
shim.chmod(0o700)
security = bin_dir / 'security'
security.write_text('#!/bin/sh\nexit 99\n')
security.chmod(0o700)
account_home, caller_home = root / 'account-home', root / 'caller-home'
account_home.mkdir()
caller_home.mkdir()
lanes = root / 'lanes'
ws = root / 'parent' / 'ws'
ws.mkdir(parents=True)
def init_repo(path):
    subprocess.run(['git', 'init', '-q', str(path)], check=True)
    subprocess.run(['git', '-C', str(path), '-c', 'user.name=Lane Test',
                    '-c', 'user.email=lane@example.invalid', '-c', 'core.hooksPath=/dev/null',
                    '-c', 'commit.gpgSign=false', 'commit', '--allow-empty', '-qm', 'base'], check=True)

init_repo(ws)
env = dict(os.environ, PATH=str(bin_dir) + ':' + os.environ['PATH'],
           OPENCODE_LANE_DIR=str(lanes), OPENCODE_LANE_SANDBOX_EXEC=str(bin_dir / 'sandbox'),
           OPENCODE_LANE_SECURITY=str(security), OPENCODE_LANE_ACCOUNT_HOME=str(account_home), HOME=str(caller_home),
           SECRET_TOKEN='x', PWD='/deliberately/wrong')
spec = root / 'spec'
spec.write_text('private prompt\nsecond line\n')
(root / 'mode').write_text('ok')
(root / 'sandbox-mode').write_text('enforce')
(root / 'session').write_text('s-123')
(root / 'text').write_text('world')
(root / 'calls').touch()
(root / 'provider-message').write_text('Model unavailable: fakeprov/fake-model')
(root / 'provider-exit').write_text('1')
(root / 'models-list').write_text('fakeprov/other-model\n  fakeprov/fake-model  \n')
(root / 'models-exit').write_text('0')
(root / 'models-mode').write_text('ok')
scenario = 'start records session and prints final text'

def check(value, message):
    if not value:
        raise AssertionError(f'{scenario}: {message}')

def run(*args, code=0, cwd=ws, input=None, overrides=None, removed=()):
    args = list(args)
    for index, argument in enumerate(args):
        if argument == '--':
            break
        if argument in ('--timeout', '--first-event-timeout') and index + 1 < len(args):
            try:
                seconds = float(args[index + 1])
            except ValueError:
                continue
            if math.isfinite(seconds) and seconds > 0:
                args[index + 1] = str(seconds * scale)
    child_env = env | (overrides or {})
    for key in removed:
        child_env.pop(key, None)
    result = subprocess.run(['bash', str(tool), *args], cwd=cwd,
                            env=child_env, input=input, text=True,
                            capture_output=True, timeout=command_timeout)
    check(result.returncode == code,
          f'expected exit {code}, got {result.returncode}: {result.stderr}')
    return result

def calls():
    return [json.loads(line) for line in (root / 'calls').read_text().splitlines()]

def start(name='job', **kwargs):
    return run('start', name, str(spec), '-m', 'fakeprov/fake-model', **kwargs)

def refused(args, message, **kwargs):
    before = len(calls())
    result = run(*args, code=2, **kwargs)
    check(message in result.stderr, f'missing diagnostic {message!r}: {result.stderr}')
    check(len(calls()) == before, 'model called on refused precondition')

def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    # Linux containers can retain orphan zombies; macOS reaps them via launchd.
    if sys.platform.startswith('linux'):
        try:
            return pathlib.Path(f'/proc/{pid}/stat').read_text().rsplit(')', 1)[1].split()[0] != 'Z'
        except FileNotFoundError:
            return False
    return True

try:
    result = start()
    check(result.stdout.strip() == 'hello \nworld', result.stdout)
    check(run('id', 'job').stdout.strip() == 's-123', 'session not persisted')
    scenario = 'harvest records base and exports empty patch'
    state = json.loads((lanes / 'job.json').read_text())
    check(state.get('base') == subprocess.check_output(['git', '-C', str(ws), 'rev-parse', 'HEAD'], text=True).strip(),
          'base commit not recorded')
    check(state.get('git_common') == str(ws / '.git'), 'common Git directory not recorded')
    check(state.get('object_format') == subprocess.check_output(
        ['git', '-C', str(ws), 'rev-parse', '--show-object-format'], text=True).strip(), 'object format not recorded')
    patch = pathlib.Path(state['patch'])
    check(patch.read_bytes() == b'' and stat.S_IMODE(patch.stat().st_mode) == 0o600, 'empty/private patch missing')
    check(f'opencode-lane: patch: {patch}' in result.stderr and 'no changes' in result.stderr, 'patch diagnostic missing')
    before = len(calls())
    harvested = run('harvest', 'job')
    check(pathlib.Path(harvested.stdout.strip()).read_bytes() == b'', 'manual harvest path missing')
    check(len(calls()) == before, 'harvest called opencode')
    scenario = 'catalog warmed before run with identical sandbox and environment'
    check(len(calls()) == 3, 'expected models, run and export')
    catalog, first, exported = calls()
    check(catalog['argv'] == ['models', '--standalone'], 'catalog command missing or out of order')
    check(catalog['stdin'] == '', 'prompt sent to catalog command')
    check(catalog['env'] == first['env'] == exported['env'], 'catalog environment differs')
    check(catalog['cwd'] == first['cwd'], 'catalog workspace differs')
    sandbox_calls = [json.loads(line) for line in (root / 'sandbox-calls').read_text().splitlines()]
    workers = [call for call in sandbox_calls if call[2] == 'opencode']
    check([call[3:] for call in workers] == [call['argv'] for call in calls()], 'worker bypassed sandbox')
    check(all(call[:3] == ['-f', str(lanes / 'job.sb'), 'opencode'] for call in workers),
          'catalog sandbox prefix differs')
    scenario = 'prompt only on stdin'
    check(first['stdin'] == spec.read_text(), 'prompt lost')
    check(all('private prompt' not in a for a in first['argv']), 'prompt in argv')
    check(first['argv'] == ['run', '--standalone', '--format', 'json', '-m',
                            'fakeprov/fake-model', '--title', 'job'], first['argv'])
    check(exported['argv'] == ['session', 'export', '--standalone', 's-123'], exported['argv'])
    scenario = 'PWD binding'
    check(first['env']['PWD'] == str(ws), first['env'].get('PWD'))
    check(first['cwd'] == str(ws), first['cwd'])
    scenario = 'environment allowlist'
    allowed = {'PATH', 'LANG', 'TERM', 'PWD', 'HOME', 'XDG_CONFIG_HOME', 'XDG_DATA_HOME',
               'XDG_STATE_HOME', 'XDG_CACHE_HOME', 'TMPDIR'}
    # CPython coerces LC_CTYPE; macOS CoreFoundation adds its encoding variable
    # even under env -i. These are runtime additions, not caller credentials.
    runtime = {'LC_CTYPE'} | ({'__CF_USER_TEXT_ENCODING'} if sys.platform == 'darwin' else set())
    check(set(first['env']) <= allowed | runtime, first['env'].keys())
    check('SECRET_TOKEN' not in first['env'], 'secret leaked')
    check(first['env']['TERM'] == 'dumb', 'TERM not bound')
    box = lanes / 'job.box'
    for key, suffix in [('HOME', 'home'), ('XDG_CONFIG_HOME', 'config'),
                        ('XDG_DATA_HOME', 'data'), ('XDG_STATE_HOME', 'state'),
                        ('XDG_CACHE_HOME', 'cache'), ('TMPDIR', 'tmp')]:
        check(first['env'][key] == str(box / suffix), key)
    check(exported['env'] == first['env'], 'export environment differs')
    scenario = 'profile and permission rules'
    profile = (lanes / 'job.sb').read_text()
    for rule in ['(version 1)', '(allow default)', '(deny file-read-data',
                 '(subpath "/Volumes")', '(subpath "/private/tmp")',
                 '(subpath "/private/var/folders")', '(deny file-write* (subpath "/"))',
                 f'(subpath "{ws}")', f'(subpath "{box}")', f'(literal "{ws.parent}")']:
        check(rule in profile, f'missing {rule}')
    check('(subpath "/Volumes")' not in profile.split('(allow file-read-data', 1)[1],
          '/Volumes allowed')
    scenario = 'account home and redirected HOME both denied'
    deny_reads = profile.split('(deny file-read-data', 1)[1].split('(allow file-read-data', 1)[0]
    scenario = 'shared temporary and Users read denies'
    check('(subpath "/private/var/tmp")' in deny_reads, 'missing /private/var/tmp read deny')
    check('(subpath "/Users")' in deny_reads, 'missing /Users read deny')
    check('(deny file-read* (literal "/dev/console"))' in profile, 'missing console read deny')
    check(f'(subpath "{account_home}")' in deny_reads and f'(subpath "{caller_home}")' in deny_reads,
          'account home or redirected HOME not denied')
    home_canary = account_home / '.local/state/opencode-lane/.home-canary'
    check(home_canary.is_file() and stat.S_IMODE(home_canary.stat().st_mode) == 0o600, 'home canary missing or exposed')
    scenario = 'supervisor and self-test environment sanitized'
    supervisor_keys = [json.loads(line) for line in (root / 'supervisor-keys').read_text().splitlines()]
    check(all('SECRET_TOKEN' not in keys for keys in supervisor_keys), 'secret in supervisor environment')
    sandbox_environments = [json.loads(line) for line in (root / 'sandbox-environments').read_text().splitlines()]
    check(all('SECRET_TOKEN' not in value for value in sandbox_environments), 'secret in sandbox inherited environment')
    supervisor_allowed = {'PATH', 'HOME', 'LANG', 'LC_ALL', 'TERM', 'TMPDIR'} | runtime
    check(all(set(keys) <= supervisor_allowed | {key for key in keys if key.startswith('OPENCODE_LANE_')}
              for keys in supervisor_keys), 'unexpected supervisor environment keys')
    scenario = 'atomic exclusive reservation'
    check((root / 'reservations').is_file(), 'reservation did not use atomic exclusive link')
    reservation = json.loads((root / 'reservations').read_text().splitlines()[0])
    check(reservation['target'] == str(lanes / 'job.json') and reservation['state']['workspace'] == str(ws),
          'reservation published incomplete state')
    state = json.loads((lanes / 'job.json').read_text())
    git_binary = subprocess.check_output(['xcrun', '--find', 'git'], text=True).strip() if \
        __import__('shutil').which('xcrun') else __import__('shutil').which('git')
    git_dir = str(pathlib.Path(git_binary).resolve().parent)
    check(first['env']['PATH'].split(':')[0] == git_dir, 'real git not first on PATH')
    for key in ['workspace', 'git_top', 'git_common', 'opencode_root', 'git_dir', 'allow_read',
                'model', 'timeout', 'first_event_timeout']:
        check(key in state, f'not recorded: {key}')
    check(state['timeout'] == 1800 and state['first_event_timeout'] == 120, 'wrong defaults')
    config = json.loads((box / 'config/opencode/opencode.json').read_text())
    permissions = config['permissions']
    scenario = 'ordered permission rule array'
    check(isinstance(permissions, list), 'permissions must be an array')
    check(all(isinstance(rule, dict) and set(rule) == {'action', 'resource', 'effect'}
              and rule['effect'] in ('allow', 'deny') for rule in permissions), 'invalid rule shape')
    expected_rules = [(action, '*') for action in
                      ['skill', 'question', 'subagent', 'webfetch', 'websearch', 'execute', 'external_directory']]
    expected_rules += [('read', '*.env'), ('read', '*.env.*')]
    expected_rules += [('shell', pattern) for pattern in
                       ['git reset --hard *', 'git clean *', 'git push *', 'git checkout -- *', 'rm -rf *']]
    check(permissions == [{'action': action, 'resource': resource, 'effect': 'deny'}
                          for action, resource in expected_rules], 'missing or reordered deny rule')
    check('plugin' not in config and 'mcp' not in config, 'plugin or MCP configured')
    check('ask' not in json.dumps(permissions), 'interactive permission')
    for path in [lanes / 'job.canary', box / 'config/opencode/opencode.json', lanes / 'job.json']:
        check(stat.S_IMODE(path.stat().st_mode) == 0o600, str(path))
    check(stat.S_IMODE(lanes.stat().st_mode) == 0o700, 'lane dir not private')
    scenario = 'Mach service isolation profile'
    check('(deny mach-lookup (global-name "com.apple.SecurityServer") '
          '(global-name "com.apple.securityd.xpc") (global-name "com.apple.security.keychain-db") '
          '(global-name "com.apple.pasteboard.1"))' in profile, 'missing Mach service deny rule')
    scenario = 'same-user IPC profile rules'
    ipc_rules = [
        '(deny process-info* (target others))',
        '(deny signal)',
        '(allow signal (target same-sandbox))',
        '(deny network-outbound (remote unix-socket))',
        '(allow network-outbound (remote unix-socket (path-literal "/private/var/run/mDNSResponder")))',
        '(deny mach-lookup (global-name "com.apple.cfprefsd.daemon") (global-name "com.apple.cfprefsd.agent"))',
        '(deny appleevent-send)',
        '(deny mach-lookup (global-name "com.apple.coreservices.appleevents"))',
    ]
    positions = []
    for rule in ipc_rules:
        check(rule in profile, f'missing {rule}')
        positions.append(profile.index(rule))
    check(positions == sorted(positions), 'IPC rules reordered')
    scenario = 'device writes restricted to safe devices and owned ptys'
    check('(subpath "/dev")' not in profile, 'blanket /dev access restored')
    device_rules = [
        '(allow file-write* (literal "/dev/null") (literal "/dev/zero") '
        '(literal "/dev/dtracehelper") (regex #"^/dev/fd/[0-9]+$"))',
        '(allow pseudo-tty)',
        '(allow file-read* file-write* file-ioctl (literal "/dev/ptmx"))',
        '(deny file-read* (regex #"^/dev/ttys[0-9]+$"))',
        '(allow file-read* file-write* (require-all (regex #"^/dev/ttys[0-9]+$") '
        '(extension "com.apple.sandbox.pty")))',
    ]
    for rule in device_rules:
        check(rule in profile, f'missing {rule}')
    scenario = 'outside tty read deny precedes owned-pty allow'
    check(profile.index(device_rules[3]) < profile.index(device_rules[4]), 'tty read deny comes after owned-pty allow')
    check([line for line in profile.splitlines() if 'file-ioctl' in line] == [device_rules[2]],
          'unexpected blanket device ioctl rule')
    scenario = 'workspace Git entry write deny rule'
    git_rule = f'(deny file-write* (literal "{ws}/.git") (subpath "{ws}/.git"))'
    check(git_rule in profile, 'missing Git entry deny rule')
    check(profile.index(git_rule) > profile.index('(allow file-write*'), 'Git deny precedes workspace allow')
    scenario = 'Git directory self-test rejects write leakage'
    (root / 'sandbox-mode').write_text('git-leak')
    refused(['next', 'job', 'blocked'], 'sandbox self-test failed: Git entry write allowed')
    check(not (ws / '.git/.opencode-lane-selftest').exists(), 'Git self-test probe leaked')
    (root / 'sandbox-mode').write_text('enforce')
    scenario = 'Git pointer self-test rejects append-open leakage'
    subprocess.run(['git', '-C', str(ws), '-c', 'user.name=Lane Test',
                    '-c', 'user.email=lane@example.invalid', '-c', 'core.hooksPath=/dev/null',
                    '-c', 'commit.gpgSign=false', 'commit', '--allow-empty', '-qm', 'fixture'], check=True)
    linked = root / 'linked'
    subprocess.run(['git', '-C', str(ws), '-c', 'core.hooksPath=/dev/null',
                    'worktree', 'add', '--detach', '-q', str(linked)], check=True)
    start('linked', cwd=linked)
    pointer = linked / '.git'
    pointer_before = pointer.read_bytes()
    (root / 'sandbox-mode').write_text('git-leak')
    refused(['next', 'linked', 'blocked'], 'sandbox self-test failed: Git entry write allowed')
    check(pointer.read_bytes() == pointer_before, 'Git pointer changed during append-open self-test')
    (root / 'sandbox-mode').write_text('enforce')
    run('drop', 'linked')
    scenario = 'hostile harvest round-trip uses recorded Git and disables execution'
    donor, hostile, clean = root / 'donor', root / 'hostile', root / 'clean'
    init_repo(donor)
    (donor / 'tracked.txt').write_text('base\n')
    subprocess.run(['git', '-C', str(donor), 'add', 'tracked.txt'], check=True)
    subprocess.run(['git', '-C', str(donor), '-c', 'user.name=Lane Test',
                    '-c', 'user.email=lane@example.invalid', '-c', 'core.hooksPath=/dev/null',
                    '-c', 'commit.gpgSign=false', 'commit', '-qm', 'tracked base'], check=True)
    subprocess.run(['git', '-C', str(donor), '-c', 'core.hooksPath=/dev/null',
                    'worktree', 'add', '--detach', '-q', str(hostile)], check=True)
    (root / 'hostile.py').write_text(r"""import pathlib, shlex, subprocess, sys
root = pathlib.Path(__file__).resolve().parent
ws = pathlib.Path.cwd()
(ws / 'tracked.txt').write_text('worker edit\n')
(ws / 'new.txt').write_text('new file\n')
(ws / 'binary.bin').write_bytes(b'\0\xffbinary\0')
hooks = ws / '.githooks'
hooks.mkdir()
script = '#!/bin/sh\ntouch ' + shlex.quote(str(root / 'executed-marker')) + '\n'
(hooks / 'pre-commit').write_text(script)
(hooks / 'pre-commit').chmod(0o700)
planted = ws / 'planted'
subprocess.run(['git', 'clone', '--bare', '-q', str(root / 'donor'), str(planted)], check=True)
for key, value in [('core.bare', 'false'), ('core.worktree', str(ws)),
                   ('core.hooksPath', str(hooks)), ('core.fsmonitor', str(hooks / 'pre-commit'))]:
    subprocess.run(['git', '--git-dir=' + str(planted), 'config', key, value], check=True)
(ws / '.git').write_text('gitdir: ' + str(planted) + '\n')
late = 'import pathlib, time; time.sleep(.5); pathlib.Path("tracked.txt").write_text("late edit\\n")'
child = subprocess.Popen([sys.executable, '-c', late], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
(root / 'late.pid').write_text(str(child.pid))
""")
    (root / 'mode').write_text('hostile')
    (root / 'sandbox-mode').write_text('worker-leak')
    result = start('harvest-hostile', cwd=hostile)
