#!/usr/bin/env bash
# opencode-lane — a sandboxed, workspace-bound worker session.
#
# Usage:
#   opencode-lane start <lane> <spec-file|-> -m <provider/model> [--allow-read DIR]...
#                       [--timeout S] [--first-event-timeout S]
#   opencode-lane next  <lane> <prompt|->
#   opencode-lane exec  <lane> [--timeout S] -- <command> [args...]
#   opencode-lane harvest <lane>
#   opencode-lane last  <lane>
#   opencode-lane id    <lane>
#   opencode-lane log   <lane>
#   opencode-lane list
#   opencode-lane drop  <lane>
#
# Requires bash, python3 3.10+, git, opencode and a working macOS sandbox-exec.
# No model default, model pass-through flags, unsandboxed mode or automatic retries.
# Timeout defaults: 1800 seconds total, 120 seconds to the first stdout line.
# Prompts reach opencode only on stdin. next resumes in the recorded workspace.
# exec reruns gates in that sandbox without opencode, passing all three streams through.
# exec defaults to a 1800-second total timeout, with no first-event timeout.
# The workspace should live outside your home directory (for example /tmp/worktree):
# opencode reads agent configuration and instructions in every ancestor up to /.
# OPENCODE_LANE_DIR defaults to ~/.local/state/opencode-lane (private, mode 700).
# Test seams: OPENCODE_LANE_SANDBOX_EXEC bypasses platform detection;
# OPENCODE_LANE_SECURITY selects the fake security binary (default /usr/bin/security).
# OPENCODE_LANE_ACCOUNT_HOME overrides the account home only with that sandbox seam.
# Internal hook: _profile <lane> is used by opencode-lane.sandbox.test.
# Harvest writes a patch against the recorded base; review and apply it in a clean
# worktree. Never run coordinator Git, editors, direnv or gates in the worker tree.
# Detached worker processes can outlive a round; the worker tree remains untrusted.
# Logs and patches survive failed rounds. drop removes the lane, logs and private stores.
# Exit: 2 precondition/usage; 3 missing session/text; 4 model mismatch;
#       5 project config created; 124 watchdog; otherwise the command's exit code.

set -euo pipefail
umask 077
die() { printf 'opencode-lane: %s\n' "$1" >&2; exit 2; }
usage() {
  awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"
  exit "${1:-2}"
}
[ "${1-}" != '--help' ] || usage 0
[ "$#" -gt 0 ] || usage
command -v python3 >/dev/null 2>&1 || die 'python3 not found on PATH'
SUPERVISOR_ENV=()
for key in PATH HOME LANG LC_ALL TERM TMPDIR ${!OPENCODE_LANE_@}; do
  if declare -p "$key" >/dev/null 2>&1; then
    SUPERVISOR_ENV+=("$key=${!key}")
  fi
done
# fd 3 preserves the caller's stdin while the heredoc supplies the Python program.
exec /usr/bin/env -i "${SUPERVISOR_ENV[@]}" python3 - "$@" 3<&0 <<'PY'
# Python 3.10+, standard library only. This process owns signals and cleanup.
import contextlib
import json
import math
import os
import platform
import pwd
from pathlib import Path
import re
import selectors
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time
import unicodedata


class Refused(Exception):
    pass


def die(message):
    raise Refused(message)


def physical(path):
    return str(Path(path).resolve(strict=True))


def atomic_write(path, content, exclusive=False):
    fd, temporary = tempfile.mkstemp(prefix='.lane-', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as out:
            out.write(content)
            out.flush()
            os.fsync(out.fileno())
        if exclusive:
            os.link(temporary, path)
        else:
            os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def publish(path, state, exclusive=False):
    atomic_write(path, json.dumps(state, indent=2) + '\n', exclusive=exclusive)


@contextlib.contextmanager
def locked(path, wait_seconds=0):
    deadline = time.monotonic() + wait_seconds
    while True:
        try:
            path.mkdir(mode=0o700)
            break
        except FileExistsError:
            if time.monotonic() >= deadline:
                die(f'busy: another lane operation holds {path}; if no run is alive, rmdir "{path}"')
            time.sleep(.05)
    try:
        yield
    finally:
        path.rmdir()


def load(path):
    if not path.is_file() or path.is_symlink():
        die(f'unknown lane: {path.stem}')
    try:
        with path.open() as source:
            value = json.load(source)
    except (ValueError, UnicodeError):
        die(f'corrupt lane state {path}: inspect and remove it')
    if not isinstance(value, dict):
        die(f'corrupt lane state {path}: inspect and remove it')
    return value


def git_paths(workspace):
    if not shutil.which('git'):
        die('git not found on PATH')
    def git(*args):
        result = subprocess.run(['git', '-C', workspace, 'rev-parse', *args],
                                capture_output=True, text=True)
        if result.returncode:
            die(f'workspace must be inside a Git work tree: {workspace}')
        return result.stdout.strip()
    if git('--is-inside-work-tree') != 'true':
        die(f'workspace must be inside a Git work tree: {workspace}')
    return physical(git('--show-toplevel')), physical(Path(workspace) / git('--git-common-dir'))


def parse_start(args):
    if len(args) < 2:
        die('start requires a spec-file and -m provider/model')
    prompt_source, options = args[0], args[1:]
    state = dict(model='', timeout=1800, first_event_timeout=120, allow_read=[])
    seen = set()
    while options:
        flag, *options = options
        if flag not in ('-m', '--timeout', '--first-event-timeout', '--allow-read'):
            die(f'unexpected argument: {flag}')
        if not options:
            die(f'missing value for {flag}')
        value, *options = options
        if flag != '--allow-read' and flag in seen:
            die(f'duplicate option: {flag}')
        seen.add(flag)
        if flag == '-m':
            if not re.fullmatch(r'[^\s/\x00-\x1f-][^\s/\x00-\x1f]*/[^\s/\x00-\x1f]+', value):
                die('model must be provider/model')
            state['model'] = value
        elif flag == '--allow-read':
            if not Path(value).is_dir():
                die(f'--allow-read directory does not exist: {value}')
            state['allow_read'].append(physical(value))
        else:
            try:
                seconds = float(value)
            except ValueError:
                die(f'{flag} must be a positive number of seconds')
            if not math.isfinite(seconds) or seconds <= 0:
                die(f'{flag} must be a positive number of seconds')
            state[flag[2:].replace('-', '_')] = seconds
    if not state['model']:
        die('missing required -m provider/model')
    return prompt_source, state


def new_state(state):
    workspace = physical(os.getcwd())
    top, common = git_paths(workspace)
    if workspace != top:
        die(f'workspace must be the Git top level: {workspace}')
    recorded = subprocess.run(['git', '-C', workspace, 'rev-parse', 'HEAD', '--path-format=absolute',
                               '--git-common-dir', '--show-object-format'],
                              capture_output=True, text=True)
    if recorded.returncode or len(recorded.stdout.splitlines()) != 3:
        die('workspace must have a base commit, common Git directory and object format')
    base, common, object_format = recorded.stdout.splitlines()
    executable = shutil.which('opencode')
    if not executable:
        die('opencode not found on PATH')
    install = Path(physical(executable)).parent
    if install.name == 'bin':
        install = install.parent
    if shutil.which('xcrun'):
        result = subprocess.run(['xcrun', '--find', 'git'], capture_output=True, text=True)
        if result.returncode or not result.stdout.strip():
            die('cannot resolve real git with xcrun --find git')
        git = result.stdout.strip()
    else:
        git = shutil.which('git')
    if not git:
        die('git not found on PATH')
    state.update(workspace=workspace, git_top=top, git_common=physical(common),
                 opencode_root=str(install), git_dir=str(Path(physical(git)).parent),
                 base=base, object_format=object_format,
                 session_id='', events='', patch='')
    return state


CONFIG_NAMES = ('opencode.json', 'opencode.jsonc', '.opencode')


def project_config(directory, ancestors=True):
    current = Path(directory)
    for parent in [current, *current.parents] if ancestors else [current]:
        names = CONFIG_NAMES if parent == current else CONFIG_NAMES + ('.claude', '.agents', 'AGENTS.md', 'CLAUDE.md')
        for name in names:
            candidate = parent / name
            if os.path.lexists(candidate):
                return candidate
    return None


def sandbox_tools():
    testing = 'OPENCODE_LANE_SANDBOX_EXEC' in os.environ
    if not testing and platform.system() != 'Darwin':
        die('no supported sandbox on this platform')
    sandbox = os.environ.get('OPENCODE_LANE_SANDBOX_EXEC', '/usr/bin/sandbox-exec')
    security = os.environ.get('OPENCODE_LANE_SECURITY', '/usr/bin/security') if testing else '/usr/bin/security'
    if any(not os.path.isfile(path) or not os.access(path, os.X_OK) for path in (sandbox, security)):
        die('no supported sandbox on this platform')
    return os.path.abspath(sandbox), os.path.abspath(security)


def account_home():
    override = os.environ.get('OPENCODE_LANE_ACCOUNT_HOME') if 'OPENCODE_LANE_SANDBOX_EXEC' in os.environ else None
    return physical(override or pwd.getpwuid(os.getuid()).pw_dir)


def home_canary():
    home = Path(account_home())
    directory = home / '.local/state/opencode-lane'
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    if not directory.resolve().is_relative_to(home):
        die(f'home canary directory escapes account home: {directory}')
    path = directory / '.home-canary'
    try:
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        info = path.lstat()
        if not stat.S_ISREG(info.st_mode) or stat.S_IMODE(info.st_mode) != 0o600:
            die(f'home canary must be a regular mode-600 file: {path}')
    else:
        with os.fdopen(descriptor, 'w') as output:
            output.write('opencode-lane private home canary\n')
    return path


def preconditions(state, lane_dir, state_file):
    workspace = state['workspace']
    for field in ('workspace', 'git_top', 'git_common'):
        if physical(state[field]) != state[field]:
            die(f'recorded {field} changed physical path: {state[field]}')
    if git_paths(workspace) != (state['git_top'], state['git_common']):
        die(f'workspace Git top level or common directory changed: {workspace}')
    shared = os.path.commonpath([str(lane_dir), workspace])
    if shared in (str(lane_dir), workspace):
        die('lane directory and workspace must not contain each other')
    for other in lane_dir.glob('*.json'):
        if other != state_file and load(other).get('workspace') == workspace:
            die(f'workspace already belongs to lane {other.stem}: {workspace}')
    config = project_config(workspace)
    if config:
        if config.parent != Path(workspace):
            die(f'agent configuration or instructions in an ancestor of the workspace: {config}; '
                'opencode reads every ancestor up to /. Create the worktree outside your home, '
                'e.g. git worktree add /tmp/<name>')
        die(f'project agent configuration refused: {config}')


def profile(state, box, target):
    roots = [state['workspace'], str(box), state['git_common'], state['opencode_root'],
             state['git_dir'], *state['allow_read']]
    homes = list(dict.fromkeys([account_home(), physical(os.environ['HOME'])]))
    for path in [*homes, *roots]:
        if not os.path.isabs(path) or any(c in path for c in ('"', '\\', '\n', '\r')):
            die(f'unsafe sandbox path: {path!r}')
    ancestors = sorted({str(parent) for root in roots for parent in Path(root).parents
                        if str(parent) != '/'})
    listings = ' '.join(f'(literal "{parent}")' for parent in ancestors)
    reads = ' '.join(f'(subpath "{root}")' for root in dict.fromkeys(roots))
    home_denials = ' '.join(f'(subpath "{home}")' for home in homes)
    atomic_write(target, '\n'.join([
        '(version 1)', '(allow default)',
        '(deny mach-lookup (global-name "com.apple.SecurityServer") '
        '(global-name "com.apple.securityd.xpc") (global-name "com.apple.security.keychain-db") '
        '(global-name "com.apple.pasteboard.1"))',
        '(deny process-info* (target others))',
        '(deny signal)',
        '(allow signal (target same-sandbox))',
        '(deny network-outbound (remote unix-socket))',
        '(allow network-outbound (remote unix-socket (path-literal "/private/var/run/mDNSResponder")))',
        '(deny mach-lookup (global-name "com.apple.cfprefsd.daemon") (global-name "com.apple.cfprefsd.agent"))',
        '(deny appleevent-send)',
        '(deny mach-lookup (global-name "com.apple.coreservices.appleevents"))',
        f'(deny file-read-data {home_denials} (subpath "/Volumes") '
        '(subpath "/private/tmp") (subpath "/private/var/folders") '
        '(subpath "/private/var/tmp") (subpath "/Users"))',
        f'(allow file-read-data {listings} {reads})',
        '(deny file-write* (subpath "/"))',
        f'(allow file-write* (subpath "{state["workspace"]}") '
        f'(subpath "{box}"))',
        # Device rules adapted from OpenAI Codex's Seatbelt base policy (Apache-2.0).
        '(allow file-write* (literal "/dev/null") (literal "/dev/zero") '
        '(literal "/dev/dtracehelper") (regex #"^/dev/fd/[0-9]+$"))',
        '(allow pseudo-tty)',
        '(allow file-read* file-write* file-ioctl (literal "/dev/ptmx"))',
        '(deny file-read* (literal "/dev/console"))',
        '(deny file-read* (regex #"^/dev/ttys[0-9]+$"))',
        '(allow file-read* file-write* (require-all (regex #"^/dev/ttys[0-9]+$") '
        '(extension "com.apple.sandbox.pty")))',
        f'(deny file-write* (literal "{state["workspace"]}/.git") '
        f'(subpath "{state["workspace"]}/.git"))',
        '',
    ]))


def prepare_box(box):
    for relative in ('', 'home', 'config', 'config/opencode', 'data', 'state', 'cache', 'tmp'):
        directory = box / relative
        if directory.is_symlink():
            die(f'private box directory is a symlink: {directory}')
        directory.mkdir(mode=0o700, exist_ok=True)


def selftest(state, sandbox, security, profile_path, lane_dir, lane):
    inside = Path(state['workspace']) / '.opencode-lane-selftest'
    outside = lane_dir / f'{lane}.sbx-probe'
    if os.path.lexists(inside) or os.path.lexists(outside):
        die('sandbox self-test failed: probe path already exists')
    tests = [('workspace write', 'touch "$1" && rm "$1"', inside, True),
             ('outside write', 'touch "$1"', outside, False),
             ('canary read', 'cat "$1"', lane_dir / f'{lane}.canary', False),
             ('home canary read', 'cat "$1"', home_canary(), False)]
    git_entry = Path(state['workspace']) / '.git'
    git_probe = git_entry / '.opencode-lane-selftest'
    if os.path.lexists(git_probe):
        die('sandbox self-test failed: Git probe path already exists')
    if git_entry.is_dir():
        tests.append(('Git entry write', 'touch "$1"', git_probe, False))
    elif git_entry.is_file():
        tests.append(('Git entry write', ': >> "$1"', git_entry, False))
    # A repository subdirectory has no .git entry, so there is nothing to probe.
    probes = [inside, outside, git_probe]
    try:
        for operation, script, path, must_succeed in tests:
            result = subprocess.run([sandbox, '-f', str(profile_path), '/bin/sh', '-c',
                                     script, 'selftest', str(path)],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                    timeout=10)
            if (result.returncode == 0) != must_succeed:
                outcome = 'denied' if must_succeed else 'allowed'
                die(f'sandbox self-test failed: {operation} {outcome}')
        result = subprocess.run([sandbox, '-f', str(profile_path), security, 'list-keychains'],
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        if result.returncode == 0:
            die('sandbox self-test failed: keychain access allowed')
    finally:
        for path in probes:
            if os.path.lexists(path):
                path.unlink()


def write_config(box):
    permissions = [{'action': action, 'resource': '*', 'effect': 'deny'} for action in
                   ('skill', 'question', 'subagent', 'webfetch', 'websearch', 'execute', 'external_directory')]
    permissions += [{'action': 'read', 'resource': pattern, 'effect': 'deny'}
                    for pattern in ('*.env', '*.env.*')]
    permissions += [{'action': 'shell', 'resource': pattern, 'effect': 'deny'} for pattern in
                    ('git reset --hard *', 'git clean *', 'git push *',
                     'git checkout -- *', 'rm -rf *')]
    atomic_write(box / 'config/opencode/opencode.json', json.dumps({'permissions': permissions}) + '\n')


def sandbox_command(state, box, sandbox, profile_path):
    environment = dict(PATH=state['git_dir'] + ':' + os.environ['PATH'],
                       LANG=os.environ.get('LANG') or 'en_US.UTF-8', TERM='dumb',
                       PWD=state['workspace'], HOME=str(box / 'home'),
                       XDG_CONFIG_HOME=str(box / 'config'), XDG_DATA_HOME=str(box / 'data'),
                       XDG_STATE_HOME=str(box / 'state'), XDG_CACHE_HOME=str(box / 'cache'),
                       TMPDIR=str(box / 'tmp'))
    return ['/usr/bin/env', '-i', *[f'{key}={value}' for key, value in environment.items()],
            sandbox, '-f', str(profile_path)]


def worker_command(state, box, sandbox, profile_path):
    return sandbox_command(state, box, sandbox, profile_path) + ['opencode']


def kill_group(process):
    # Popen(start_new_session=True) makes this pid our own session/group leader.
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    process.wait()


def supervise(command, state, prompt, output, errors, total_timeout, first_event_timeout=None):
    started = time.monotonic()
    first_line = False
    first_budget = state['first_event_timeout'] if first_event_timeout is None else first_event_timeout
    exited_at = None
    with tempfile.TemporaryFile() as source, selectors.DefaultSelector() as selector:
        source.write(prompt)
        source.seek(0)
        process = subprocess.Popen(command, cwd=state['workspace'], stdin=source,
                                   stdout=subprocess.PIPE, stderr=errors, start_new_session=True)
        try:
            selector.register(process.stdout, selectors.EVENT_READ)
            while selector.get_map() or process.poll() is None:
                now = time.monotonic()
                elapsed = now - started
                if process.poll() is not None:
                    exited_at = now if exited_at is None else exited_at
                    if now - exited_at >= 2 or elapsed >= total_timeout:
                        return process.returncode
                elif elapsed >= total_timeout or (not first_line and elapsed >= first_budget):
                    print('opencode-lane: watchdog timeout; process group killed', file=sys.stderr)
                    return 124
                for key, _ in selector.select(timeout=max(0, min(.05, total_timeout - elapsed))):
                    chunk = os.read(key.fd, 65536)
                    if not chunk:
                        selector.unregister(key.fileobj)
                    else:
                        output.write(chunk)
                        output.flush()
                        first_line = first_line or b'\n' in chunk
            return process.wait()
        finally:
            kill_group(process)
            process.stdout.close()


def event_result(path):
    first = True
    session = ''
    text = []
    errors = []
    with open(path, errors='replace') as events:
        for line in events:
            try:
                event = json.loads(line)
            except ValueError:
                continue
            if first:
                first = False
                session = event.get('sessionID', '') if isinstance(event, dict) else ''
            if isinstance(event, dict) and event.get('type') == 'text':
                part = event.get('part')
                if isinstance(part, dict) and isinstance(part.get('text'), str):
                    text.append(part['text'])
            if isinstance(event, dict) and event.get('type') == 'error':
                error = event.get('error')
                error = error if isinstance(error, dict) else {}
                diagnostic = f'opencode-lane: provider error: {error.get("type", "unknown")}: {error.get("message", "")}'
                errors.append(''.join(c for c in diagnostic if not unicodedata.category(c).startswith('C'))[:300])
    if not isinstance(session, str) or not session or session.startswith('-') or any(ord(c) < 32 for c in session):
        session = ''
    return session, '\n'.join(text), errors


def exit_status(code):
    return code if code >= 0 else 128 - code


ROUND_CONFIG_NAMES = (*CONFIG_NAMES, '.claude', '.agents')


def configuration_violation(workspace, before):
    for name in ROUND_CONFIG_NAMES:
        path = Path(workspace) / name
        if name not in before and os.path.lexists(path):
            print(f'opencode-lane: project agent configuration created: {path}', file=sys.stderr)
            return 5
    return 0


def prepare_sandbox(state, lane_dir, lane, sandbox, security):
    box, profile_path = lane_dir / f'{lane}.box', lane_dir / f'{lane}.sb'
    prepare_box(box)
    atomic_write(lane_dir / f'{lane}.canary', 'opencode-lane private canary\n')
    profile(state, box, profile_path)
    selftest(state, sandbox, security, profile_path, lane_dir, lane)
    return box, profile_path


def parse_exec(args):
    timeout = 1800
    if args[:1] == ['--timeout']:
        if len(args) < 2:
            die('missing value for --timeout')
        try:
            timeout = float(args[1])
        except ValueError:
            die('--timeout must be a positive number of seconds')
        if not math.isfinite(timeout) or timeout <= 0:
            die('--timeout must be a positive number of seconds')
        args = args[2:]
    if len(args) < 2 or args[0] != '--':
        die('exec requires [--timeout S] -- command [args...]')
    return timeout, args[1:]


def exec_run(state, lane_dir, lane, sandbox, security, args):
    timeout, command = parse_exec(args)
    box, profile_path = prepare_sandbox(state, lane_dir, lane, sandbox, security)
    process = subprocess.Popen(sandbox_command(state, box, sandbox, profile_path) + command,
                               cwd=state['workspace'], stdin=3, start_new_session=True)
    try:
        try:
            result = exit_status(process.wait(timeout=timeout))
        except subprocess.TimeoutExpired:
            print('opencode-lane: watchdog timeout; process group killed', file=sys.stderr)
            result = 124
    finally:
        kill_group(process)
    return result


def round_body(state, state_file, lane_dir, lane, sandbox, security, prompt, is_start):
    before = {name for name in ROUND_CONFIG_NAMES if os.path.lexists(Path(state['workspace']) / name)}
    box, profile_path = prepare_sandbox(state, lane_dir, lane, sandbox, security)
    write_config(box)
    base = worker_command(state, box, sandbox, profile_path)
    deadline = time.monotonic() + state['timeout']
    warmup_budget = min(120, max(0, deadline - time.monotonic()))
    with tempfile.TemporaryFile() as catalog, tempfile.TemporaryFile() as catalog_errors:
        catalog_result = supervise(base + ['models', '--standalone'], state, b'', catalog,
                                   catalog_errors, warmup_budget, first_event_timeout=warmup_budget)
        catalog.seek(0)
        offered = any(line.strip() == state['model'].encode() for line in catalog)
        if catalog_result or not offered:
            detail = f' (opencode exit {exit_status(catalog_result)})' if catalog_result else ''
            die(f'model not offered: {state["model"]}{detail}')
    command = base + ['run', '--standalone', '--format', 'json', '-m', state['model'], '--title', lane]
    if not is_start:
        if not state['session_id']:
            die('lane has no session id; inspect its log and start a new lane')
        command += ['--session', state['session_id']]
    stamp = str(time.time_ns())
    events = lane_dir / f'{lane}.{stamp}.events.jsonl'
    stderr = lane_dir / f'{lane}.{stamp}.stderr.log'
    with events.open('xb') as output, stderr.open('xb') as errors:
        try:
            result = exit_status(supervise(command, state, prompt, output, errors,
                                           max(0, deadline - time.monotonic())))
        finally:
            session, text, provider_errors = event_result(events)
            if is_start:
                state['session_id'] = session
            state['events'] = str(events)
            publish(state_file, state)
        violation = configuration_violation(state['workspace'], before)
        if violation:
            return violation
        export_result = 0
        if state['session_id']:
            with tempfile.TemporaryFile() as exported:
                export_result = exit_status(supervise(
                    base + ['session', 'export', '--standalone', state['session_id']],
                    state, b'', exported, errors, max(0, deadline - time.monotonic())))
                violation = configuration_violation(state['workspace'], before)
                if violation:
                    return violation
                if export_result == 0:
                    exported.seek(0)
                    try:
                        info = json.load(exported)['info']['model']
                        actual = info['providerID'] + '/' + info['id']
                    except (ValueError, KeyError, TypeError):
                        actual = '<missing model>'
                    if actual != state['model']:
                        print(f'opencode-lane: model mismatch: requested {state["model"]}, got {actual}', file=sys.stderr)
                        return 4
        if provider_errors:
            for diagnostic in provider_errors:
                print(diagnostic, file=sys.stderr)
            return result or 3
    if result:
        return result
    if export_result:
        return export_result
    if not state['session_id']:
        print(f'opencode-lane: first JSON event has no sessionID; logs: {events}', file=sys.stderr)
        return 3
    if not text:
        print(f'opencode-lane: no final text; logs: {events}', file=sys.stderr)
        return 3
    print(text)
    return 0


def harvest(state, state_file, lane_dir, lane):
    patch = lane_dir / f'{lane}.{time.time_ns()}.patch'
    # Share objects, never repository config or the worker-writable box HOME.
    with tempfile.TemporaryDirectory(prefix=f'.{lane}.harvest-', dir=lane_dir) as temporary:
        private = Path(temporary) / 'git'
        home = Path(temporary) / 'home'
        home.mkdir(mode=0o700)
        environment = dict(PATH=state['git_dir'] + ':/usr/bin:/bin', HOME=str(home),
                           GIT_DIR=str(private), GIT_WORK_TREE=state['workspace'], GIT_CONFIG_NOSYSTEM='1',
                           GIT_CONFIG_GLOBAL='/dev/null')
        def git_step(command, output=subprocess.DEVNULL):
            values = environment if command[0] != 'init' else {
                key: value for key, value in environment.items() if key not in ('GIT_DIR', 'GIT_WORK_TREE')}
            base = ['/usr/bin/env', '-i', *[f'{key}={value}' for key, value in values.items()], 'git']
            result = subprocess.run(base + command, cwd=state['workspace'], stdout=output,
                                    stderr=subprocess.PIPE)
            if result.returncode:
                die(f'harvest failed ({command[0]}, Git exit {result.returncode}): '
                    + result.stderr.decode(errors='replace').strip())

        try:
            git_step(['init', '--bare', '--object-format=' + state['object_format'], str(private)])
            common = Path(state['git_common'])
            (private / 'objects/info/alternates').write_text(str(common / 'objects') + '\n')
            exclude = common / 'info/exclude'
            if exclude.is_file():
                shutil.copyfile(exclude, private / 'info/exclude')
            git_step(['read-tree', state['base']])
            untracked = Path(temporary) / 'untracked'
            with untracked.open('xb') as output:
                git_step(['ls-files', '-z', '--others', '--exclude-standard'], output)
            # Broad add also examines tracked gitlinks using their untrusted config.
            if untracked.stat().st_size:
                git_step(['add', '--intent-to-add', '--pathspec-from-file=' + str(untracked),
                          '--pathspec-file-nul'])
            with patch.open('xb') as output:
                git_step(['diff', '--binary', '--no-color', '--full-index',
                          '--ignore-submodules=dirty', state['base']], output)
        except BaseException:
            patch.unlink(missing_ok=True)
            raise
    state['patch'] = str(patch)
    publish(state_file, state)
    print(f'opencode-lane: patch: {patch}', file=sys.stderr)
    if patch.stat().st_size == 0:
        print('opencode-lane: no changes', file=sys.stderr)
    return patch


def round_run(state, state_file, lane_dir, lane, sandbox, security, prompt, is_start):
    previous_events = state['events']
    try:
        return round_body(state, state_file, lane_dir, lane, sandbox, security, prompt, is_start)
    finally:
        if state['events'] != previous_events:
            harvest(state, state_file, lane_dir, lane)


def drop(lane_dir, lane, remove_logs=True):
    # Exact ownership patterns: a lane named a.b must survive dropping a.
    for suffix in ('json', 'canary', 'sb'):
        (lane_dir / f'{lane}.{suffix}').unlink(missing_ok=True)
    pattern = re.compile(re.escape(lane) + r'\.[0-9]+\.(events\.jsonl|stderr\.log|patch)$')
    for entry in lane_dir.iterdir():
        if remove_logs and pattern.fullmatch(entry.name):
            entry.unlink()
    box = lane_dir / f'{lane}.box'
    if box.is_symlink():
        box.unlink()
    elif box.exists():
        shutil.rmtree(box)


def main():
    if sys.version_info < (3, 10):
        die('python3 3.10 or newer is required')
    command, *args = sys.argv[1:]
    if command not in ('start', 'next', 'exec', 'last', 'id', 'log', 'list', 'drop', 'harvest', '_profile'):
        die(f'unknown command: {command}')
    lane = '' if command == 'list' else (args[0] if args else '')
    if command != 'list' and not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', lane):
        die(f'invalid lane name: {lane!r}')
    expected = 0 if command == 'list' else 2 if command == 'next' else 1
    if command not in ('start', 'exec') and len(args) != expected:
        die(f'unexpected or missing arguments for {command}')
    raw_dir = os.environ.get('OPENCODE_LANE_DIR') or str(Path.home() / '.local/state/opencode-lane')
    lane_dir = Path(raw_dir).absolute().resolve()
    lane_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    if stat.S_IMODE(lane_dir.stat().st_mode) != 0o700:
        die(f'lane directory must be mode 700 (no group/other access): {lane_dir}')
    state_file = lane_dir / f'{lane}.json'
    if command == 'list':
        for path in sorted(lane_dir.glob('*.json')):
            state = load(path)
            print(f'{path.stem}\t{state["workspace"]}\t{state["model"]}')
        return 0
    if command in ('id', 'log', 'last'):
        state = load(state_file)
        if command == 'last':
            text = event_result(state['events'])[1] if state['events'] else ''
            if not text:
                return 3
            print(text)
        else:
            print(state['session_id' if command == 'id' else 'events'])
        return 0
    with locked(lane_dir / f'{lane}.lock'):
        if command == 'drop':
            drop(lane_dir, lane)
            return 0
        if command == '_profile':
            profile(load(state_file), lane_dir / f'{lane}.box', lane_dir / f'{lane}.sb')
            return 0
        if command == 'harvest':
            state = load(state_file)
            print(harvest(state, state_file, lane_dir, lane))
            return 0
        is_start = command == 'start'
        sandbox, security = sandbox_tools()
        if command == 'exec':
            state = load(state_file)
            with locked(lane_dir / '.registry.lock', wait_seconds=30):
                preconditions(state, lane_dir, state_file)
            return exec_run(state, lane_dir, lane, sandbox, security, args[1:])
        # Serialize workspace claims across lane names, then release before the model runs.
        with locked(lane_dir / '.registry.lock', wait_seconds=30):
            if is_start:
                if os.path.lexists(state_file):
                    die(f'lane already exists: {lane}')
                for suffix in ('canary', 'sb', 'box'):
                    if os.path.lexists(lane_dir / f'{lane}.{suffix}'):
                        die(f'lane artifacts already exist: {lane}; inspect before drop')
                prompt_source, state = parse_start(args[1:])
                state = new_state(state)
            else:
                state = load(state_file)
                prompt_source = args[1]
            preconditions(state, lane_dir, state_file)
            if prompt_source == '-':
                with os.fdopen(os.dup(3), 'rb') as source:
                    prompt = source.read()
            elif is_start:
                prompt = Path(prompt_source).read_bytes()
            else:
                prompt = prompt_source.encode()
            if not prompt.strip():
                die('empty prompt')
            if is_start:
                publish(state_file, state, exclusive=True)
        try:
            return round_run(state, state_file, lane_dir, lane, sandbox, security, prompt, is_start)
        except (Refused, OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired):
            if is_start and not state['events']:
                drop(lane_dir, lane, remove_logs=False)
            raise


def interrupted(signum, frame):
    raise SystemExit(128 + signum)


signal.signal(signal.SIGTERM, interrupted)
signal.signal(signal.SIGINT, interrupted)
try:
    sys.exit(main())
except (Refused, OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired) as error:
    print(f'opencode-lane: {error}', file=sys.stderr)
    sys.exit(2)
