{
  "permissions": {
    "deny": [
      "Edit(./collections/pstack/skills/**)",
      "Write(./collections/pstack/skills/**)",
      "Edit(./collections/pstack/UPSTREAM)",
      "Edit(./collections/pstack/LICENSE*)",
      "Edit(./collections/pstack/NOTICE*)"
    ],
    "ask": [
      "Bash(gh pr merge*)",
      "Bash(git push origin main*)",
      "Bash(tools/scripts/deploy.sh*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" baseline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" stop -- 'cd tools && bun run typecheck && bun run lint && bun test'",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
